# Copy to .env for `npm run dev` / `npm start`. Every value is optional; defaults are shown.
# docker compose sets SMTP_HOST/SMTP_PORT itself so email goes to the Mailpit container.

# --- Server ---
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# true behind a load balancer (e.g. AWS ALB) so rate limits use the real client IP.
TRUST_PROXY=false

# --- Product source (Fake Store) ---
FAKESTORE_BASE_URL=https://fakestoreapi.com
FAKESTORE_TIMEOUT_MS=5000
# How long the catalogue is cached in memory. 0 disables caching.
CATALOGUE_CACHE_TTL_SECONDS=300
CURRENCY=AUD
# The owner's "top rated" picks for the home page, in display order (max 5).
FEATURED_PRODUCT_IDS=1,5,11,17,18

# --- Enquiry email ---
# Defaults point at Mailpit (http://localhost:8025). Swap for any SMTP relay, e.g. Amazon SES SMTP.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SALES_INBOX=sales@catalogue.local
ENQUIRY_FROM=Catalogue <no-reply@catalogue.local>

# --- Abuse protection (per client IP) ---
ENQUIRY_RATE_LIMIT_PER_MINUTE=5
API_RATE_LIMIT_PER_MINUTE=300
